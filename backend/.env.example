# --- App ---
ENV=development
TESTING=false

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://careergraph:careergraph@localhost:5432/careergraph

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=careergraph

# --- Auth ---
JWT_SECRET=change-me-to-a-real-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- LLM provider (pluggable) ---
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- CORS ---
FRONTEND_URL=http://localhost:5173
