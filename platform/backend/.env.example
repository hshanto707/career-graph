# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://careergraph:careergraph@localhost:5432/careergraph

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=careergraph

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── LLM Providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ─── LLM Configuration ───────────────────────────────────────────────────────
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6

# ─── CORS / Frontend ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Ollama (local LLM fallback) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Custom / Self-hosted Model (vLLM / HuggingFace TGI) ─────────────────────
# Set LLM_PROVIDER=custom to use these
CUSTOM_MODEL_URL=http://localhost:8080
CUSTOM_MODEL_NAME=careergraph-v1
